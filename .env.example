# PostgreSQL Database Connection URL (e.g. postgresql://user:password@localhost:5432/tradeguard)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tradeguard"

# LLM API Provider Keys (Optional: If missing or invalid, Trade-Guard automatically uses deterministic financial risk engine fallback)
LLM_API_KEY=""
LLM_PROVIDER="gemini" # Options: gemini | openai

# Market Data Provider Keys (Optional)
MARKET_DATA_API_KEY=""

# Application Environment
NODE_ENV="development"
PORT=3000
